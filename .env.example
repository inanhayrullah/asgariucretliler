NEXT_PUBLIC_SITE_NAME=Mesai
# Leave unset until the production domain is chosen. Used for canonical URL and sitemap.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key from Supabase; the anon key name remains supported for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLISH_CRON_SECRET=
# AdSense client ID. No ad script is loaded until consent and publisher setup are implemented.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Free local legal guide; set to openai or google only when you want paid/external AI.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Configure trusted RSS hosts and scheduler after review. No feeds are fetched in this MVP.
RSS_ALLOWED_HOSTS=
RSS_CRON_SECRET=
